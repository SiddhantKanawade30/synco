// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  DONE
  REJECTED
  BACKLOG
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id    String @id @default(cuid())
  name String
  email String @unique
  password String
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdIssues  Issue[] @relation("IssueCreator")
  assignedIssues Issue[] @relation("Assignee")
  activities     Activity[]
  memberships    ProjectMember[]
  ownedProjects Project[]
}

model Project {
  id    String @id @default(cuid())
  name String 

  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ProjectMember[]
  issues Issue[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  role      ProjectRole @default(MEMBER)

  userId    String
  projectId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId]) // prevents duplicate membership
}

model Issue {
  id  String @id @default(cuid())
  title String
  description String?
  status IssueStatus
  priority IssuePriority
  deadline DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])

  assigneeId String?
  assignee User? @relation("Assignee",fields: [assigneeId], references: [id], onDelete: Cascade)
  @@index([assigneeId])

  creatorId String
  creator User @relation("IssueCreator", fields: [creatorId], references: [id])
  @@index([creatorId])

  activities Activity[]
}

model Activity {
  id String @id @default(cuid())
  type String // COMMENT, STATUS_CHANGE, ASSIGNED
  content String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issueId String
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  @@index([issueId])

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
} 